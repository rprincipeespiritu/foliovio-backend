PORT=3001
APP_ORIGIN=http://localhost:5173
JWT_SECRET=cambia-por-un-secreto-aleatorio-de-al-menos-32-caracteres
ADMIN_SECRET=
# PostgreSQL de desarrollo: crea la base antes de arrancar.
DATABASE_URL=postgresql://foliovio:foliovio_local@localhost:5432/foliovio
# Base exclusiva para pruebas (requiere permiso CREATE SCHEMA).
TEST_DATABASE_URL=postgresql://foliovio:foliovio_local@localhost:5432/foliovio_test
# Lax para localhost, mismo origen o subdominios del mismo sitio.
# none solo con HTTPS en producción si frontend y API están en sitios distintos.
COOKIE_SAME_SITE=lax
# SendGrid: remitente verificado y API key con permiso Mail Send.
# Si faltan, la API sigue disponible pero no puede enviar activaciones.
SENDGRID_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Foliovio
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_ID=
# Paddle Billing: usa las cinco variables del mismo entorno. Sin ellas el checkout está deshabilitado.
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_ID=
